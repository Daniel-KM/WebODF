{
    "manifest_version": 3,
    "name": "OpenDocument Viewer",
    "version": "@WEBODF_MANIFEST_VERSION@",
    "description": "Light reader for the documents of LibreOffice and compatible applications, in the OpenDocument format — text, spreadsheet, presentation, drawing and formula — without an office suite.",
    "author": "Daniel Berthereau",
    "homepage_url": "http://webodf.org/",
    "default_locale": "en",
    "minimum_chrome_version": "88",
    "icons": {
        "128": "skin/default/icon.png"
    },
    "permissions": [
        "declarativeNetRequest",
        "downloads"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background-chrome.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["viewer.html"],
            "matches": ["<all_urls>"]
        }
    ]
}
