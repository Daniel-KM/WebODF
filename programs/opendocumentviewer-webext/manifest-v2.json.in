{
    "manifest_version": 2,
    "name": "OpenDocument Viewer",
    "version": "@WEBODF_MANIFEST_VERSION@",
    "description": "Light reader for .odt, .ods and .odp documents of LibreOffice and compatible applications, without an office suite.",
    "author": "Daniel Berthereau",
    "homepage_url": "http://webodf.org/",
    "default_locale": "en",
    "browser_specific_settings": {
        "gecko": {
            "id": "uriloader@webodf.js",
            "data_collection_permissions": {
                "required": ["none"]
            },
            "strict_min_version": "52.0"
        }
    },
    "icons": {
        "128": "skin/default/icon.png"
    },
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "downloads",
        "<all_urls>"
    ],
    "background": {
        "scripts": ["background.js"]
    },
    "web_accessible_resources": ["viewer.html"]
}
