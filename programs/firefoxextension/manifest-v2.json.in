{
    "manifest_version": 2,
    "name": "ODF Viewer",
    "version": "@WEBODF_VERSION@",
    "description": "Viewer for files in OpenDocument Format (ODF), powered by WebODF, using only web standard technologies.",
    "author": "Daniel Berthereau",
    "homepage_url": "http://webodf.org/",
    "browser_specific_settings": {
        "gecko": {
            "id": "uriloader@webodf.js",
            "strict_min_version": "48.0"
        }
    },
    "icons": {
        "48": "skin/default/icon.png"
    },
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "downloads",
        "<all_urls>"
    ],
    "background": {
        "scripts": ["background.js"]
    },
    "web_accessible_resources": ["viewer.html"]
}
